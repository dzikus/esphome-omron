# ESPHome / PlatformIO build artifacts
.esphome/
.pio/
tests/.pio/
.build/

# Local secrets (never publish)
secrets.yaml
*-secrets.yaml

# Logs
logs/

# Python
__pycache__/
*.pyc
.venv/

# Ruff cache
.ruff_cache/

# Editor swap files
*.swp
*.swo
*~

# IDE / editor (generated by the devcontainer IntelliSense setup)
.vscode/c_cpp_properties.json
.vscode/compile_commands.json

# ESPHome writes these into .github when the CI config is built there
.github/.esphome/
.github/.gitignore
